{
  "name": "klucznik",
  "version": "0.0.0",
  "private": true,
  "description": "Klucznik – Twój e-recepcjonista. Multi-tenant system rezerwacji dla małych obiektów noclegowych.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=11.28.2 <12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1"
  }
}
