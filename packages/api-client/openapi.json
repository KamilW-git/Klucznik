{
  "components": {
    "schemas": {
      "AdminPropertyListItemDto": {
        "properties": {
          "city": {
            "example": "Mikołajki",
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "name": {
            "example": "Domki Leśna Polana",
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/AdminPropertyOwnerDto"
          },
          "roomsCount": {
            "description": "Liczba pokoi (bez usuniętych)",
            "example": 4,
            "type": "number"
          },
          "slug": {
            "example": "lesna-polana",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "city",
          "isActive",
          "owner",
          "roomsCount",
          "createdAt"
        ],
        "type": "object"
      },
      "AdminPropertyOwnerDto": {
        "properties": {
          "email": {
            "example": "jan.nowak@example.com",
            "type": "string"
          },
          "firstName": {
            "example": "Jan",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lastName": {
            "example": "Nowak",
            "type": "string"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email"
        ],
        "type": "object"
      },
      "AdminPropertyPageDto": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/AdminPropertyListItemDto"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "type": "object"
      },
      "AuthResponseDto": {
        "properties": {
          "accessToken": {
            "description": "JWT do nagłówka `Authorization: Bearer …` (trzymany tylko w pamięci SPA)",
            "type": "string"
          },
          "expiresIn": {
            "description": "Czas życia access tokenu w sekundach",
            "example": 900,
            "type": "number"
          },
          "user": {
            "$ref": "#/components/schemas/MeDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ],
        "type": "object"
      },
      "CreateOwnerDto": {
        "properties": {
          "email": {
            "example": "jan.nowak@example.com",
            "maxLength": 254,
            "type": "string"
          },
          "firstName": {
            "example": "Jan",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "example": "Nowak",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "description": "Hasło tymczasowe (admin przekazuje je właścicielowi poza systemem)",
            "maxLength": 200,
            "minLength": 10,
            "type": "string"
          },
          "property": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CreateOwnerPropertyDto"
              }
            ],
            "description": "Obiekt zakładany od razu (Q-07)"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "password"
        ],
        "type": "object"
      },
      "CreateOwnerPropertyDto": {
        "properties": {
          "name": {
            "description": "Nazwa obiektu",
            "example": "Domki Leśna Polana",
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "slug": {
            "description": "Adres strony `/o/:slug`. Bez niego generowany z nazwy (z sufiksem przy kolizji).",
            "example": "lesna-polana",
            "maxLength": 60,
            "minLength": 3,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ErrorResponseDto": {
        "properties": {
          "code": {
            "description": "Stabilny kod maszynowy (UPPER_SNAKE_CASE). UI rozpoznaje błędy wyłącznie po nim.",
            "example": "RESERVATION_OVERLAP",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "description": "Dane dodatkowe zależne od kodu. Dla VALIDATION_ERROR: `{ fields: [{ field, messages }] }`.",
            "example": {
              "conflictingReservationNumber": "KL-2026-000118"
            },
            "type": "object"
          },
          "error": {
            "description": "Nazwa kodu HTTP",
            "example": "Conflict",
            "type": "string"
          },
          "message": {
            "description": "Komunikat po polsku (pomocniczy)",
            "example": "Wybrany termin koliduje z inną rezerwacją.",
            "type": "string"
          },
          "path": {
            "description": "Ścieżka żądania",
            "example": "/api/v1/properties/2b1…/reservations",
            "type": "string"
          },
          "requestId": {
            "description": "Identyfikator żądania (także w nagłówku X-Request-Id)",
            "example": "6f0c2a7e-4c1b-4a8e-9a43-1d6f5f1c2b3a",
            "type": "string"
          },
          "statusCode": {
            "description": "Kod HTTP",
            "example": 409,
            "type": "number"
          },
          "timestamp": {
            "description": "Czas błędu (ISO 8601 UTC)",
            "example": "2026-08-01T10:15:30.000Z",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "error",
          "code",
          "message",
          "path",
          "timestamp",
          "requestId"
        ],
        "type": "object"
      },
      "HealthCheckDto": {
        "properties": {
          "details": {
            "additionalProperties": {
              "additionalProperties": true,
              "properties": {
                "status": {
                  "enum": [
                    "up",
                    "down"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status"
              ],
              "type": "object"
            },
            "description": "Wyniki wskaźników według nazwy usługi, np. `{ \"database\": { \"status\": \"up\" } }`",
            "example": {},
            "type": "object"
          },
          "error": {
            "additionalProperties": {
              "additionalProperties": true,
              "properties": {
                "status": {
                  "enum": [
                    "up",
                    "down"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status"
              ],
              "type": "object"
            },
            "description": "Wyniki wskaźników według nazwy usługi, np. `{ \"database\": { \"status\": \"up\" } }`",
            "example": {},
            "type": "object"
          },
          "info": {
            "additionalProperties": {
              "additionalProperties": true,
              "properties": {
                "status": {
                  "enum": [
                    "up",
                    "down"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status"
              ],
              "type": "object"
            },
            "description": "Wyniki wskaźników według nazwy usługi, np. `{ \"database\": { \"status\": \"up\" } }`",
            "example": {},
            "type": "object"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthStatus"
              }
            ],
            "example": "ok"
          }
        },
        "required": [
          "status",
          "details"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok",
          "error",
          "shutting_down"
        ],
        "type": "string"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "description": "E-mail (bez rozróżniania wielkości liter)",
            "example": "jan.nowak@example.com",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "description": "Hasło",
            "example": "Haslo-demo-123",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "MeDto": {
        "properties": {
          "email": {
            "example": "jan.nowak@example.com",
            "type": "string"
          },
          "firstName": {
            "example": "Jan",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lastName": {
            "example": "Nowak",
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ],
            "example": "OWNER"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "role"
        ],
        "type": "object"
      },
      "OwnerDto": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "example": "jan.nowak@example.com",
            "type": "string"
          },
          "firstName": {
            "example": "Jan",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isActive": {
            "description": "`false` = konto zablokowane",
            "type": "boolean"
          },
          "lastName": {
            "example": "Nowak",
            "type": "string"
          },
          "properties": {
            "items": {
              "$ref": "#/components/schemas/OwnerPropertyDto"
            },
            "type": "array"
          },
          "propertiesCount": {
            "example": 1,
            "type": "number"
          },
          "reservationsLast30Days": {
            "description": "Rezerwacje utworzone w ostatnich 30 dniach",
            "example": 12,
            "type": "number"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "isActive",
          "propertiesCount",
          "reservationsLast30Days",
          "createdAt",
          "properties"
        ],
        "type": "object"
      },
      "OwnerListItemDto": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "email": {
            "example": "jan.nowak@example.com",
            "type": "string"
          },
          "firstName": {
            "example": "Jan",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isActive": {
            "description": "`false` = konto zablokowane",
            "type": "boolean"
          },
          "lastName": {
            "example": "Nowak",
            "type": "string"
          },
          "propertiesCount": {
            "example": 1,
            "type": "number"
          },
          "reservationsLast30Days": {
            "description": "Rezerwacje utworzone w ostatnich 30 dniach",
            "example": 12,
            "type": "number"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "isActive",
          "propertiesCount",
          "reservationsLast30Days",
          "createdAt"
        ],
        "type": "object"
      },
      "OwnerPageDto": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/OwnerListItemDto"
            },
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "type": "object"
      },
      "OwnerPropertyDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "name": {
            "example": "Domki Leśna Polana",
            "type": "string"
          },
          "slug": {
            "example": "lesna-polana",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "isActive"
        ],
        "type": "object"
      },
      "PaginationMetaDto": {
        "properties": {
          "page": {
            "example": 1,
            "type": "number"
          },
          "pageSize": {
            "example": 20,
            "type": "number"
          },
          "totalItems": {
            "example": 134,
            "type": "number"
          },
          "totalPages": {
            "example": 7,
            "type": "number"
          }
        },
        "required": [
          "page",
          "pageSize",
          "totalItems",
          "totalPages"
        ],
        "type": "object"
      },
      "Role": {
        "enum": [
          "ADMIN",
          "OWNER"
        ],
        "type": "string"
      },
      "UpdateOwnerDto": {
        "properties": {
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "firstName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "isActive": {
            "description": "`false` blokuje konto i unieważnia wszystkie sesje (Q-10)",
            "type": "boolean"
          },
          "lastName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "description": "Nowe hasło tymczasowe",
            "maxLength": 200,
            "minLength": 10,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "kl_refresh": {
        "in": "cookie",
        "name": "kl_refresh",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "REST API systemu rezerwacji Klucznik. Konwencje: docs/architecture/api-conventions.md",
    "title": "Klucznik API",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/admin/owners": {
      "get": {
        "operationId": "AdminOwners_list",
        "parameters": [
          {
            "description": "Numer strony (od 1)",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "example": 1,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "description": "Liczba elementów na stronie",
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 20,
              "example": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "description": "Sortowanie `pole:asc|desc`, wiele po przecinku. Dozwolone pola: createdAt, lastName.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "createdAt:desc",
              "example": "createdAt:desc",
              "type": "string"
            }
          },
          {
            "description": "Szukaj w imieniu, nazwisku i e-mailu (min. 2 znaki)",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "example": "nowak",
              "type": "string"
            }
          },
          {
            "description": "Filtr: aktywne (`true`) lub zablokowane (`false`)",
            "in": "query",
            "name": "isActive",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnerPageDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "BR-12: rola inna niż ADMIN"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Lista właścicieli z wyszukiwaniem i paginacją",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "operationId": "AdminOwners_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOwnerDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnerDto"
                }
              }
            },
            "description": "Nagłówek `Location` wskazuje nowego właściciela"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "BR-12: rola inna niż ADMIN"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "EMAIL_TAKEN, SLUG_TAKEN"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Zakłada właściciela (opcjonalnie od razu z obiektem)",
        "tags": [
          "admin"
        ]
      }
    },
