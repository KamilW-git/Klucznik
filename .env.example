# Wzór zmiennych środowiskowych. Skopiuj do `.env` i uzupełnij wartości `change-me`.
# Opis zmiennych: docs/architecture/infrastructure.md#zmienne-środowiskowe
#
# Wartości hostów poniżej są dla `pnpm dev` na hoście (usługi z `docker compose up -d postgres redis mailpit`).
# Kontener `api` w docker-compose.yml nadpisuje je nazwami usług (postgres, redis, mailpit).

# --- postgres ---
POSTGRES_USER=klucznik
POSTGRES_PASSWORD=change-me
POSTGRES_DB=klucznik
# Port na hoście. Zmień, gdy 5432 zajmuje lokalny PostgreSQL, i popraw port w DATABASE_URL.
POSTGRES_PORT=5432

# --- api ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://klucznik:change-me@localhost:5432/klucznik
REDIS_HOST=localhost
REDIS_PORT=6379

# Min. 32 znaki, np. `openssl rand -base64 48`.
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

APP_PUBLIC_URL=http://localhost:8080
APP_TIMEZONE=Europe/Warsaw

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM='"Klucznik" <no-reply@klucznik.local>'

STORAGE_DRIVER=local
# Względem katalogu apps/api przy `pnpm dev`; kontener `api` używa /data/uploads (wolumen `uploads`).
STORAGE_LOCAL_PATH=./uploads
UPLOAD_MAX_BYTES=10485760

THROTTLE_TTL=60
THROTTLE_LIMIT=100

SWAGGER_ENABLED=true
SCHEDULER_ENABLED=true

# --- seed (pnpm prisma:seed) ---
SEED_ADMIN_EMAIL=admin@klucznik.local
SEED_ADMIN_PASSWORD=change-me
SEED_OWNER_PASSWORD=change-me

# --- web (build) ---
VITE_API_BASE_URL=/api/v1

# --- testy ---
# Gdy ustawiona, testy integracyjne używają tej bazy zamiast Testcontainers.
# TEST_DATABASE_URL=postgresql://klucznik:change-me@localhost:5432/klucznik_test
