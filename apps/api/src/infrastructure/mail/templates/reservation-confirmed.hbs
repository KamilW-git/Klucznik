<p>Dzień dobry {{guest.firstName}},</p>
<p>Twoja rezerwacja w obiekcie
  <strong>{{property.name}}</strong>
  została potwierdzona. Do zobaczenia!</p>
<table role='presentation' cellpadding='0' cellspacing='0' style='margin:16px 0;font-size:15px;'>
  <tr><td style='padding:2px 12px 2px 0;color:#7a7a7a;'>Numer</td><td
    >{{reservation.number}}</td></tr>
  <tr><td style='padding:2px 12px 2px 0;color:#7a7a7a;'>Pokój</td><td>{{room.name}}</td></tr>
  <tr><td style='padding:2px 12px 2px 0;color:#7a7a7a;'>Przyjazd</td><td>{{date
        reservation.checkIn
      }}, od
      {{property.checkInTime}}</td></tr>
  <tr><td style='padding:2px 12px 2px 0;color:#7a7a7a;'>Wyjazd</td><td>{{date
        reservation.checkOut
      }}, do
      {{property.checkOutTime}}</td></tr>
  <tr><td style='padding:2px 12px 2px 0;color:#7a7a7a;'>Goście</td><td
    >{{reservation.guestsCount}}</td></tr>
  <tr><td style='padding:2px 12px 2px 0;color:#7a7a7a;'>Kwota</td><td>{{money
        reservation.totalPrice
        reservation.currency
      }}</td></tr>
</table>
{{#if reservation.cancellableUntil}}<p>Możesz bezpłatnie anulować rezerwację do
    <strong>{{date reservation.cancellableUntil}}</strong>.</p>{{/if}}
<p>Kontakt z gospodarzem:{{#if property.phone}} tel. {{property.phone}}{{/if}}{{#if
    property.contactEmail
  }} {{property.contactEmail}}{{/if}}{{#if property.city}},
    {{#if property.street}}{{property.street}}, {{/if}}{{#if
      property.postalCode
    }}{{property.postalCode}} {{/if}}{{property.city}}{{/if}}</p>
<p><a
    href='{{links.manage}}'
    style='display:inline-block;padding:10px 18px;background:#2f5d50;color:#ffffff;text-decoration:none;border-radius:6px;'
  >Zarządzaj rezerwacją</a></p>
<p style='font-size:13px;color:#7a7a7a;'>Działa tylko link z najnowszego e-maila. Nie przekazuj go
  innym osobom.</p>