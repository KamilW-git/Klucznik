<p>Gość anulował rezerwację <strong>{{reservation.number}}</strong>. Termin jest znowu wolny.</p>
<table role='presentation' cellpadding='0' cellspacing='0' style='margin:16px 0;font-size:15px;'>
  <tr><td style='padding:2px 12px 2px 0;color:#7a7a7a;'>Gość</td><td>{{guest.firstName}}
      {{guest.lastName}}</td></tr>
  <tr><td style='padding:2px 12px 2px 0;color:#7a7a7a;'>Pokój</td><td>{{room.name}}</td></tr>
  <tr><td style='padding:2px 12px 2px 0;color:#7a7a7a;'>Pobyt</td><td>{{date reservation.checkIn}}
      –
      {{date reservation.checkOut}}
      ({{pluralNights reservation.nights}})</td></tr>
  {{#if reservation.cancellationReason}}<tr><td
        style='padding:2px 12px 2px 0;color:#7a7a7a;'
      >Powód</td><td>{{reservation.cancellationReason}}</td></tr>{{/if}}
</table>
<p><a href='{{links.panel}}'>Otwórz w panelu</a></p>