<!doctype html>
<html lang='pl'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>{{property.name}}</title>
  </head>
  <body
    style='margin:0;padding:0;background:#f4f1ea;font-family:Arial,Helvetica,sans-serif;color:#2b2b2b;'
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background:#f4f1ea;'
    >
      <tr>
        <td align='center' style='padding:24px 12px;'>
          <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            style='max-width:560px;background:#ffffff;border-radius:8px;'
          >
            <tr>
              <td style='padding:24px 28px;border-bottom:1px solid #e6e1d6;'>
                <h1 style='margin:0;font-size:20px;color:#2f5d50;'>{{property.name}}</h1>
              </td>
            </tr>
            <tr>
              <td style='padding:24px 28px;font-size:15px;line-height:1.55;'>
                {{{body}}}
              </td>
            </tr>
            <tr>
              <td
                style='padding:16px 28px;border-top:1px solid #e6e1d6;font-size:12px;color:#7a7a7a;'
              >
                <p style='margin:0;'>Rezerwacje obsługuje Klucznik</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>